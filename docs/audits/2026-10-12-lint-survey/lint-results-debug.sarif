                        {
                            "id": "UnrememberedMutableState",
                            "shortDescription": {
                                "text": "Creating a state object during composition without using remember",
                                "markdown": "Creating a state object during composition without using `remember`"
                            },
                            "fullDescription": {
                                "text": "State objects created during composition need to be `remember`ed, otherwise they will be recreated during recomposition, and lose their state. Either hoist the state to an object that is not created during composition, or wrap the state in a call to remember.",
                                "markdown": "State objects created during composition need to be `remember`ed, otherwise they will be recreated during recomposition, and lose their state. Either hoist the state to an object that is not created during composition, or wrap the state in a call to `remember`."
                            },
                            "defaultConfiguration": {
