                                        "text": "\n    val abandonedTrackSweepOnce = AbandonedTrackSweepOnce(endAbandonedTracksUseCase, processStartedAtEpochMillis) { sweep ->\n        if (sweep.ended.isNotEmpty()) Log.i(SWEEP_TAG, \"Ended ${sweep.ended.size} track(s) left open by an earlier process, each at its last stored point.\")\n        sweep.ended.filter { it.clampedFromEpochMillis != null }.forEach {\n            Log.w(SWEEP_TAG, \"Track '${it.trackId}': its last stored point is at ${it.clampedFromEpochMillis}, before its start at ${it.endedAtEpochMillis}; ended at its start.\")\n"
                                    }
                                }
                            }
                        }
