                {
                    "ruleId": "ClickableViewAccessibility",
                    "ruleIndex": 2,
                    "message": {
                        "text": "Custom view `MapView` has setOnTouchListener called on it but does not override performClick",
                        "markdown": "Custom view ``MapView`` has `setOnTouchListener` called on it but does not override `performClick`"
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uriBaseId": "%SRCROOT%",
                                    "uri": "app/src/main/java/com/zynergylabs/forager/app/ui/map/SightingsMap.kt"
