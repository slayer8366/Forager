                                    "snippet": {
                                        "text": "    private fun rawBindableBeforeBind(provider: ProcessCameraProvider, selector: CameraSelector, facing: CameraFacing): Boolean =\n        runCatching { rawCaptureSize(mapCameraCapabilities(readCameraCapabilities(provider.getCameraInfo(selector), facing))) != null }\n            .onFailure { Log.w(TAG, \"Couldn't read the camera's RAW support before binding; binding JPG.\", it) }\n            .getOrDefault(false)\n            .also { ok -> if (!ok) Log.i(TAG, \"RAW was asked for but this camera does not offer it within the operating limit; binding JPG.\") }\n"
                                    }
                                }
                            }
                        }
