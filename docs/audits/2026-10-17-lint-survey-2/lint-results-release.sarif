                                    "endLine": 138,
                                    "snippet": {
                                        "text": "    <application\n        android:name=\".ForagerApplication\"\n        android:allowBackup=\"false\"\n        android:icon=\"@mipmap/ic_launcher\"\n        android:label=\"@string/app_name\"\n"
                                    }
                                }
                            }
