                                    "startLine": 164,
                                    "endLine": 169,
                                    "snippet": {
                                        "text": "    is OrientationReapplyOutcome.Kept -> if (outcome.tag == ExifInterface.ORIENTATION_UNDEFINED) ExifInterface.ORIENTATION_NORMAL else outcome.tag\n    is OrientationReapplyOutcome.Declined, is OrientationReapplyOutcome.Failed -> {\n        Log.w(TAG, \"The JPG kept the HAL's orientation tag ($outcome); the DNG takes the shot's $intendedRotationDegrees° and the two may not agree.\")\n        exifOrientationTagFor(intendedRotationDegrees) ?: ExifInterface.ORIENTATION_NORMAL\n    }\n"
                                    }
                                }
                            }
                        }
