# Forager's US + Canada map and routing build (owner's go, 2026-10-18). Installed 2026-10-18 and
# run by forager-build.timer in place of forager-build.service, on the owner's later word
# ("Switch over the timer to us and Canada"), which superseded answer 3's "once the first build
# has worked". Five days, not four hours: the two extracts alone took most of a day over the Pi's
# Bluetooth link, and the build itself has never been timed at this size.
# Install: copy to /etc/systemd/system/, add a forager-build.timer drop-in with
# `[Timer] Unit=forager-build-usca.service`, `systemctl daemon-reload`.
[Unit]
Description=Forager map and routing build (US + Canada)
Documentation=file:/opt/forager-build/map-build/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=forager-build
Group=forager-build
Environment=HOME=/srv/forager-build
WorkingDirectory=/srv/forager-build
ExecStart=/opt/forager-build/map-build/bin/build-usca.sh
TimeoutStartSec=5d

# Yield to the tile server and the tunnel. The kernel has the memory cgroup disabled
# (cgroup_disable=memory), so MemoryMax= would be inert here. Memory is bounded by the JVM's -Xmx
# (pins.env), and the OOM killer is pointed at this build first.
Nice=10
IOSchedulingClass=idle
CPUWeight=20
OOMScoreAdjust=800

# Hardening, as on the tile units. No MemoryDenyWriteExecute: the JVM's JIT needs it off.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/forager-build
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
