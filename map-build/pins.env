# Every pinned version, URL, checksum and signing key for Forager's map and routing build
# (dispatch 2026-09-28-495). Sourced by the scripts in bin/. Shell syntax: KEY=value, no spaces.
# Why each value was chosen, and how each was checked, is in
# docs/audits/2026-10-04-pi-build-part1-report.md.

# --- Where things live on the Pi --------------------------------------------------------------
# Toolchain and built jars: root-owned, read-only to the build user.
FB_OPT=/opt/forager-build
# Sources, working files, outputs, logs: owned by the build user.
FB_SRV=/srv/forager-build
FB_USER=forager-build

# --- Java: Eclipse Temurin (Debian bookworm has no Java 21) -----------------------------------
TEMURIN_VERSION=21.0.12.1+1
TEMURIN_FILE=OpenJDK21U-jdk_aarch64_linux_hotspot_21.0.12.1_1.tar.gz
TEMURIN_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_aarch64_linux_hotspot_21.0.12.1_1.tar.gz
TEMURIN_SHA256=23e37e026f12f3e706f18938ff611db3032d075b09d0879a25d06718c773e223
# The archive unpacks to this directory name.
TEMURIN_DIR=jdk-21.0.12.1+1
# Adoptium's signing key. Fingerprint cross-checked on 2026-10-04 at keyserver.ubuntu.com,
# keys.openpgp.org, packages.adoptium.net and Adoptium's documentation source.
TEMURIN_SIGNER_FPR=3B04D753C9050D9A5D343F39843C48A565F8F04B
TEMURIN_SIGNER_KEY=keys/adoptium-3B04D753C9050D9A5D343F39843C48A565F8F04B.asc

# --- Apache Maven (Debian's maven would pull in OpenJDK 17) ------------------------------------
MAVEN_VERSION=3.9.16
MAVEN_FILE=apache-maven-3.9.16-bin.tar.gz
MAVEN_URL=https://downloads.apache.org/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.tar.gz
MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6
MAVEN_DIR=apache-maven-3.9.16
# The release manager's key (Slawomir Jaranowski). Fingerprint cross-checked on 2026-10-04 in
# downloads.apache.org/maven/KEYS, at keyserver.ubuntu.com and keys.openpgp.org, and in Apache's
# committer key registry (people.apache.org/keys/committer/).
MAVEN_SIGNER_FPR=84789D24DF77A32433CE1F079EB80E92EB2135B1
MAVEN_SIGNER_KEY=keys/maven-sjaranowski-84789D24DF77A32433CE1F079EB80E92EB2135B1.asc

# --- osmium-tool, from Debian (apt verifies it through the signed archive index) --------------
OSMIUM_DEB_VERSION=1.15.0-1

# --- The map profile: protomaps/basemaps, tiles 4.15.2 -----------------------------------------
# The repository has no tag for tiles versions; this is the commit that set 4.15.2 and the last
# commit to touch tiles/ (checked 2026-10-04).
BASEMAPS_REPO=https://github.com/protomaps/basemaps.git
BASEMAPS_COMMIT=ca93fc06efbaff1c5f069d06edbe5de18839c1c8
BASEMAPS_TILES_VERSION=4.15.2
# From tiles/pom.xml at that commit; Maven fetches it from Maven Central.
PLANETILER_VERSION=0.10.2
BASEMAPS_PATCH=patches/protomaps-basemaps/0001-roads-trail-attributes.patch
# The jar `mvn package` produces at that commit.
BASEMAPS_JAR_NAME=protomaps-basemap-HEAD-with-deps.jar

# --- BRouter: the jar from the release zip (owner's ruling E, RECORD -601) ---------------------
# If the zip's jar lacks the map creator, stop and ask the owner; do not compile instead.
BROUTER_VERSION=1.7.10
BROUTER_COMMIT=4d2639af77ea5ed9c30d3e400764eb6f9e8522da
BROUTER_FILE=brouter-1.7.10.zip
BROUTER_URL=https://github.com/abrensch/brouter/releases/download/v1.7.10/brouter-1.7.10.zip
# GitHub's own digest of the release asset; BRouter publishes no checksum file.
BROUTER_SHA256=023fec3ba997758e8cd7ab9e1bae52e962af3f00b57683e3de86b84ffad01532
BROUTER_SIZE=6724983
# Classes checked inside the zip's jar before anything else runs: the map creator, the command-line
# router, and the OSM PBF and protobuf classes the map creator reads the extract with.
BROUTER_REQUIRED_CLASSES="btools/mapcreator/OsmFastCutter.class btools/mapcreator/PosUnifier.class btools/mapcreator/WayLinker.class btools/server/BRouter.class org/openstreetmap/osmosis/osmbinary/Fileformat.class com/google/protobuf/CodedInputStream.class"
# --- BRouter's routing profiles: from its source at BROUTER_COMMIT (owner's ruling, change 5) ----
# The release zip leaves all.brf and softaccess.brf out (brouter-server/build.gradle:75-77 at the
# tag), and the map creator reads both. So every profile file the build or its verification reads
# comes from misc/profiles2 at the tag, each checked against its git blob hash (`git hash-object`);
# the hashes match the tag's tree as GitHub reports it, checked 2026-10-04. Only the jar comes
# from the zip.
BROUTER_PROFILES_URL=https://raw.githubusercontent.com/abrensch/brouter/4d2639af77ea5ed9c30d3e400764eb6f9e8522da/misc/profiles2
BROUTER_PROFILE_BLOBS="lookups.dat:60e59d083bfff198e27e14aae6a3d4ed44e1cb2b all.brf:35b46729f73ffb179cfd14e9614d1c6adc796d4e trekking.brf:42135d41d1adbbc9c09eeaab190350a1ea2de3cc softaccess.brf:88d5a81d3f01fc940b2720473bcc1d03fa77a175 hiking-mountain.brf:f2bed1a5c21895195d6fe47c4b1982b5f0a0d4c5"

# --- OpenStreetMap extracts (Geofabrik) ---------------------------------------------------------
GEOFABRIK_BASE=https://download.geofabrik.de/north-america/us
EXTRACT_STATES="oregon washington"
EXTRACT_NAME=forager-orwa

# --- The profile's other sources (Basemap.java at BASEMAPS_COMMIT) ------------------------------
# None publishes a checksum; each file's size, ETag and SHA-256 go into the run's manifest.
# Static: fetched once.
SRC_NATURAL_EARTH_URL=https://naciscdn.org/naturalearth/packages/natural_earth_vector.gpkg.zip
SRC_LANDCOVER_URL=https://r2-public.protomaps.com/datasets/daylight-landcover.gpkg
SRC_QRANK_URL=https://qrank.toolforge.org/download/qrank.csv.gz
SRC_PGF_URL=https://wipfli.github.io/pgf-encoding/pgf-encoding.zip
# Coastline-derived polygons: refreshed monthly (owner's ruling C, RECORD -601).
SRC_WATER_URL=https://osmdata.openstreetmap.de/download/water-polygons-split-3857.zip
SRC_LAND_URL=https://osmdata.openstreetmap.de/download/land-polygons-split-3857.zip
COASTLINE_MAX_AGE_DAYS=30

# --- Build settings (estimates until the first run measures them) -----------------------------
PLANETILER_XMX=4g
BROUTER_XMX=2g
MAXZOOM=15
KEEP_GOOD_OUTPUTS=2
HTTP_USER_AGENT="forager-map-build/1 (Forager, an open-source foraging app)"
