# Every pinned version, URL, checksum and signing key for Forager's map and routing build
# (dispatch 2026-09-28-495). Sourced by the scripts in bin/. Shell syntax: KEY=value, no spaces.
# Why each value was chosen, and how each was checked, is in
# docs/audits/2026-10-04-pi-build-part1-report.md.

# --- Where things live on the Pi --------------------------------------------------------------
# Toolchain and built jars: root-owned, read-only to the build user.
FB_OPT=/opt/forager-build
# Sources, working files, outputs, logs: owned by the build user.
FB_SRV=/srv/forager-build
FB_USER=forager-build

# --- Java: Eclipse Temurin (Debian bookworm has no Java 21) -----------------------------------
TEMURIN_VERSION=21.0.12.1+1
TEMURIN_FILE=OpenJDK21U-jdk_aarch64_linux_hotspot_21.0.12.1_1.tar.gz
TEMURIN_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_aarch64_linux_hotspot_21.0.12.1_1.tar.gz
TEMURIN_SHA256=23e37e026f12f3e706f18938ff611db3032d075b09d0879a25d06718c773e223
# The archive unpacks to this directory name.
TEMURIN_DIR=jdk-21.0.12.1+1
# Adoptium's signing key. Fingerprint cross-checked on 2026-10-04 at keyserver.ubuntu.com,
# keys.openpgp.org, packages.adoptium.net and Adoptium's documentation source.
TEMURIN_SIGNER_FPR=3B04D753C9050D9A5D343F39843C48A565F8F04B
TEMURIN_SIGNER_KEY=keys/adoptium-3B04D753C9050D9A5D343F39843C48A565F8F04B.asc

# --- Apache Maven (Debian's maven would pull in OpenJDK 17) ------------------------------------
MAVEN_VERSION=3.9.16
MAVEN_FILE=apache-maven-3.9.16-bin.tar.gz
MAVEN_URL=https://downloads.apache.org/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.tar.gz
MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6
MAVEN_DIR=apache-maven-3.9.16
# The release manager's key (Slawomir Jaranowski). Fingerprint cross-checked on 2026-10-04 in
# downloads.apache.org/maven/KEYS, at keyserver.ubuntu.com and keys.openpgp.org, and in Apache's
# committer key registry (people.apache.org/keys/committer/).
MAVEN_SIGNER_FPR=84789D24DF77A32433CE1F079EB80E92EB2135B1
MAVEN_SIGNER_KEY=keys/maven-sjaranowski-84789D24DF77A32433CE1F079EB80E92EB2135B1.asc

# --- osmium-tool, from Debian (apt verifies it through the signed archive index) --------------
OSMIUM_DEB_VERSION=1.15.0-1

# --- The map profile: protomaps/basemaps, tiles 4.15.2 -----------------------------------------
# The repository has no tag for tiles versions; this is the commit that set 4.15.2 and the last
# commit to touch tiles/ (checked 2026-10-04).
BASEMAPS_REPO=https://github.com/protomaps/basemaps.git
BASEMAPS_COMMIT=ca93fc06efbaff1c5f069d06edbe5de18839c1c8
BASEMAPS_TILES_VERSION=4.15.2
# From tiles/pom.xml at that commit; Maven fetches it from Maven Central.
PLANETILER_VERSION=0.10.2
# Applied in this order (0002: dispatch 2026-10-22-pi-30; 0003 and 0004: dispatch 2026-10-28, way-to route ends across houses;
# 0005: dispatch 2026-10-30-coder-05, streets from zoom 10; 0006: dispatch 2026-10-31-coder-06, orchards, plant nurseries
# and vineyards).
BASEMAPS_PATCHES="patches/protomaps-basemaps/0001-roads-trail-attributes.patch patches/protomaps-basemaps/0002-landuse-forest-over-bare-rock.patch patches/protomaps-basemaps/0003-barriers-address-street-water-tunnel.patch patches/protomaps-basemaps/0004-barriers-mark-every-zoom15-tile.patch patches/protomaps-basemaps/0005-minor-roads-z10.patch patches/protomaps-basemaps/0006-orchard-nursery-vineyard.patch"
# The jar `mvn package` produces at that commit.
BASEMAPS_JAR_NAME=protomaps-basemap-HEAD-with-deps.jar

# --- BRouter: the jar from the release zip (owner's ruling E, RECORD -601) ---------------------
# If the zip's jar lacks the map creator, stop and ask the owner; do not compile instead.
BROUTER_VERSION=1.7.10
BROUTER_COMMIT=4d2639af77ea5ed9c30d3e400764eb6f9e8522da
BROUTER_FILE=brouter-1.7.10.zip
BROUTER_URL=https://github.com/abrensch/brouter/releases/download/v1.7.10/brouter-1.7.10.zip
# GitHub's own digest of the release asset; BRouter publishes no checksum file.
BROUTER_SHA256=023fec3ba997758e8cd7ab9e1bae52e962af3f00b57683e3de86b84ffad01532
BROUTER_SIZE=6724983
# Classes checked inside the zip's jar before anything else runs: the map creator, the command-line
# router, and the OSM PBF and protobuf classes the map creator reads the extract with.
BROUTER_REQUIRED_CLASSES="btools/mapcreator/OsmFastCutter.class btools/mapcreator/PosUnifier.class btools/mapcreator/WayLinker.class btools/server/BRouter.class org/openstreetmap/osmosis/osmbinary/Fileformat.class com/google/protobuf/CodedInputStream.class"
# --- BRouter's routing profiles: from its source at BROUTER_COMMIT (owner's ruling, change 5) ----
# The release zip leaves all.brf and softaccess.brf out (brouter-server/build.gradle:75-77 at the
# tag), and the map creator reads both. So every profile file the build or its verification reads
# comes from misc/profiles2 at the tag, each checked against its git blob hash (`git hash-object`);
# the hashes match the tag's tree as GitHub reports it, checked 2026-10-04. Only the jar comes
# from the zip.
# The 5-degree routing squares kept: the ones Oregon and Washington lie in. Washington's extract
# carries ferry routes to Alaska whole, so BRouter also writes squares up the coast holding nothing
# but stretches of ferry; those are deleted after the build and listed in the manifest (owner's
# ruling after change 7's first run, 2026-10-04).
RD5_SQUARES="W120_N40 W120_N45 W125_N40 W125_N45"
BROUTER_PROFILES_URL=https://raw.githubusercontent.com/abrensch/brouter/4d2639af77ea5ed9c30d3e400764eb6f9e8522da/misc/profiles2
BROUTER_PROFILE_BLOBS="lookups.dat:60e59d083bfff198e27e14aae6a3d4ed44e1cb2b all.brf:35b46729f73ffb179cfd14e9614d1c6adc796d4e trekking.brf:42135d41d1adbbc9c09eeaab190350a1ea2de3cc softaccess.brf:88d5a81d3f01fc940b2720473bcc1d03fa77a175 hiking-mountain.brf:f2bed1a5c21895195d6fe47c4b1982b5f0a0d4c5"

# --- OpenStreetMap extracts (Geofabrik) ---------------------------------------------------------
GEOFABRIK_BASE=https://download.geofabrik.de/north-america/us
EXTRACT_STATES="oregon washington"
EXTRACT_NAME=forager-orwa

# --- The profile's other sources (Basemap.java at BASEMAPS_COMMIT) ------------------------------
# None publishes a checksum; each file's size, ETag and SHA-256 go into the run's manifest.
# Static: fetched once.
SRC_NATURAL_EARTH_URL=https://naciscdn.org/naturalearth/packages/natural_earth_vector.gpkg.zip
SRC_LANDCOVER_URL=https://r2-public.protomaps.com/datasets/daylight-landcover.gpkg
SRC_QRANK_URL=https://qrank.toolforge.org/download/qrank.csv.gz
SRC_PGF_URL=https://wipfli.github.io/pgf-encoding/pgf-encoding.zip
# Coastline-derived polygons: refreshed monthly (owner's ruling C, RECORD -601).
SRC_WATER_URL=https://osmdata.openstreetmap.de/download/water-polygons-split-3857.zip
SRC_LAND_URL=https://osmdata.openstreetmap.de/download/land-polygons-split-3857.zip
COASTLINE_MAX_AGE_DAYS=30

# --- Build settings (estimates until the first run measures them) -----------------------------
PLANETILER_XMX=4g
BROUTER_XMX=2g
MAXZOOM=15
KEEP_GOOD_OUTPUTS=2
HTTP_USER_AGENT="forager-map-build/1 (Forager, an open-source foraging app)"

# --- build-usca.sh: the US + Canada build (owner's go, 2026-10-18) ----------------------------
# Whole countries, from north-america/ rather than us/, and Puerto Rico and the US Virgin Islands as
# regions of their own. Geofabrik's us extract carries Alaska and Hawaii but not the two islands.
# They are listed as its subregions on north-america/us.html (read 2026-10-18), which was taken to
# mean the extract held them, and it does not: us-261017 has no nodes in either island's box
# (2026-10-19, docs/audits/2026-10-19-usca-routing-bands-report.md addendum). The owner's word of
# 2026-10-19 was "publish now, add PR later", and of 2026-10-20 "Write the Puerto Rico dispatch"
# (dispatch 2026-10-20-pi-14). Geofabrik publishes each island as its own extract nested under us/,
# from the same planet snapshot as us and canada (all four state.txt read 2026-10-20), so the
# same-snapshot rule holds. Each entry is the region's path under USCA_GEOFABRIK_BASE, which builds
# its URLs; its basename, the stem, names its local files and outline (build-usca.sh,
# region_url_dir). us stays first: the merge stamps the first region's sequence into its header.
USCA_GEOFABRIK_BASE=https://download.geofabrik.de/north-america
USCA_REGIONS="us canada us/puerto-rico us/us-virgin-islands"
# The regions a basemap with no .regions file beside it is taken to hold (build-usca.sh,
# basemap_regions_match). Every archive built before that file existed was built with
# USCA_REGIONS="us canada", the only value it had until pi-14 (git log -S'USCA_REGIONS=', from
# 92856ef1), so such a basemap is accepted for a us canada run, as before, and for no other.
USCA_BASEMAP_UNLISTED_REGIONS="us canada"
USCA_EXTRACT_NAME=forager-usca
# Downloads (build-usca.sh's curl_resume, dispatch 2026-10-20-pi-09 part F). 19 GB over the Pi's
# Bluetooth link (about 0.2 MB/s) is interrupted more than once, and a connection can slow or stall
# without ending. So each connection is given up when it averages under SPEED_LIMIT bytes/s for
# SPEED_TIME seconds, and the next resumes with -C - after PAUSE seconds, up to MAX_RESTARTS
# connections per file. curl's own --retry is not used: with -C - it resends the offset it started
# from (measured against a local server, curl 7.88.1). This floor is for the tether, and for any link but Wi-Fi (pi-11): replayed
# against the two plain-curl stretches in sources/osm/dl.log (172 and 319 KB/s, 2026-10-18), 50
# kB/s over 120 s trips only inside a 229 s stretch with no progress at all, while the 700 kB/s
# over 40 s of the 2026-10-18 restart loop trips in 1842 of 1884 windows. That loop ran on Wi-Fi
# (900 KB/s over 155 connections), where restarting a slowed connection won back its fast start;
# a slowed Wi-Fi connection runs at the tether's normal speed, so no single floor does both, and
# this one gives the Wi-Fi speed-up away (docs/audits/2026-10-20-pi-09-disk-fit-phase1.md). The
# pause keeps a connection that fails at once to six a minute; 500 connections bound that at
# about 83 minutes (the Wi-Fi loop needed 90 and 65).
USCA_DOWNLOAD_SPEED_LIMIT=50000
USCA_DOWNLOAD_SPEED_TIME=120
# The Wi-Fi floor (dispatch 2026-10-20-pi-11, owner: "Build the Wi-Fi speed floor"), used for a
# connection when the IPv4 default route with the lowest metric, read from /proc/net/route before
# that connection, goes through an interface matching USCA_WIFI_IFACE_PATTERN. Anything else, no
# default route, or a table that cannot be read gets the floor above. 700000 bytes/s over 40 s is
# the 2026-10-18 restart loop's, which ran wholly on Wi-Fi (NetworkManager's journal). Its 155
# connections (153 ended by this floor, 2 completed) moved 14,955 MiB at 881,575 bytes/s over the
# wall clock with 5 s pauses; with this script's 10 s pause the same connections would make
# 845,225 bytes/s. A connection this floor gives up on has run 40 s straight under 700,000, slower
# than that, so restarting it is the better bet on average. The same afternoon's unrestarted Wi-Fi
# connection (sources/osm/dl.log, from 12:50) averaged 326,651 bytes/s over 1,520 s; this floor
# would first have ended it at 60 s, the floor above never. Whether a connection given up would
# have recovered by itself is not in the data: per-second figures exist only for slow Wi-Fi
# connections, so no other value can be scored against this one.
# (docs/audits/2026-10-20-pi-11-link-floor.md)
USCA_WIFI_IFACE_PATTERN='wl*'
USCA_DOWNLOAD_SPEED_LIMIT_WIFI=700000
USCA_DOWNLOAD_SPEED_TIME_WIFI=40
USCA_DOWNLOAD_PAUSE=10
USCA_DOWNLOAD_MAX_RESTARTS=500
# Before asking Geofabrik anything, wait at most this long, polling, for a default route and the
# host to resolve (part G). The unit's After=network-online.target did not stop the 2026-10-11 and
# 10-18 firings failing at name lookup. An hour covers a tether or DHCP reconnect; past that a
# person is needed. --local runs do not wait.
USCA_NETWORK_WAIT_SECONDS=3600
USCA_NETWORK_POLL_SECONDS=15
# The SD card (owner, 2026-10-19: "not easily removable so you can feel confident it'll stay in.
# But it's still limited to SD card quality"). It holds what is re-downloadable and read straight
# through: the extracts, linked from sources/osm (part B), and each run's merged extract, removed
# after Planetiler (part C), so the published map stays on the NVMe until the new one is done
# (owner, 2026-10-20: "always keep the last map"). Measured 58 MB/s writing and 96 MB/s reading.
# The build refuses to write here unless USCA_CARD_MOUNT is a mounted filesystem.
USCA_CARD_MOUNT=/mnt/archive
USCA_CARD_DIR=/mnt/archive/forager-build
# Heap as for Oregon + Washington (4g there peaked at 5.9 GB resident with the memory maps). The
# node map, features and multipolygon geometries are memory-mapped files on disk, so the heap
# does not grow with the input; whether 4g is enough for this input is untested until the first
# run. sparsearray suits a country-sized extract: node IDs are spread across the planet's range.
USCA_PLANETILER_XMX=4g
USCA_NODEMAP_TYPE=sparsearray
# BRouter's cutter holds about 16 bytes per node of its input (2 GB ran out at 134M nodes, 512 MB at
# 33M; 2026-10-19), so the heap bounds how many nodes one routing band may hold. 4g, with nothing
# else running, leaves the 8 GB Pi about 3.5 GB for the OS and the cutter's own files.
# USCA_BROUTER_MAX_BAND_NODES is the operating limit, not the 268M a 4 GB heap would hold at 16
# bytes: a band over it stops the run before BRouter starts, rather than an OutOfMemoryError
# partway through. WayLinker's need at this size is not measured; at 27M nodes it peaked at 2.1 GB
# resident on a 2 GB heap.
USCA_BROUTER_XMX=4g
USCA_BROUTER_MAX_BAND_NODES=160000000
# Longitude bands for the routing data, WEST:EAST, contiguous from -180 to 180 on 5-degree lines
# so every .rd5 square falls in exactly one; a band cannot be narrower than one square. Drawn from
# the routing input itself (USCA_ROUTING_FILTER, 2026-10-17 extracts: 826,768,719 nodes, counted
# per 5-degree strip, the strips summing to that total). Core nodes per band: 63.6M, 92.8M,
# 106.2M, 70.1M, 62.7M, 67.2M, 75.7M, 114.9M, 82.9M and 90.7M; the 1-degree margin and whole ways
# add to each. Measured with the margin: -85:-80, the densest square column (Ohio, Michigan,
# Ontario, Florida), 150.1M; -120:-110, 128.4M. The first list, from a highway-and-ferry cut, would
# have put -80:180 near 187M. The last band runs to 180 so the Aleutian squares past the
# antimeridian (E170, E175) need no band of their own.
USCA_ROUTING_BANDS="-180:-125 -125:-120 -120:-110 -110:-100 -100:-95 -95:-90 -90:-85 -85:-80 -80:-75 -75:180"
USCA_ROUTING_BAND_MARGIN=1
# osmium tags-filter expressions for the routing input (build-usca.sh section 6). The way keys are
# the four all.brf gives a cost to (highway, railway, waterway, route; every other way gets
# 100000), so the cut should not change which ways reach the .rd5 squares. Relations: route, for
# the network tags, and restrictions, which OsmFastCutter writes to restrictions.dat.
USCA_ROUTING_FILTER="w/highway w/railway w/waterway w/route r/route r/type=restriction"
# The disk check (part D), in bytes, at the state stage and again at the merge. Planetiler's peak
# on the NVMe as multiples of the inputs' bytes, from the 261017 run (usca-20261019T011311Z.log;
# inputs 12,212,909,513 + 6,516,972,934 = 18,729,882,447 bytes): its summary's `features 104GB`
# and `archive 33GB`, and `2.8G used for multipolygon way geometries`. Planetiler prints sizes in
# units of 10^9, rounded down (the archive, 33,973,424,728 bytes, printed as 33GB), so each ratio
# is taken from the top of its printed figure and rounded up: features 105e9/I = 5.606, archive
# 33.97e9/I = 1.814, multipolygon 2.9e9/I = 0.155. The 19G node location cache is left out: it
# belongs to the read passes, which end with features at 73 GB, and that phase's total is under the
# archive phase's (inferred). Nothing else of the run is on the NVMe then: the downloads and the
# merged extract are on the card. The card needs the bytes still to download plus the inputs'
# bytes for the merged extract. Each need gets MARGIN_PERCENT more, and at least MARGIN_MIN_BYTES
# more: the ratios come from one run.
USCA_DISK_FEATURES_RATIO=5.61
USCA_DISK_ARCHIVE_RATIO=1.82
USCA_DISK_MULTIPOLYGON_RATIO=0.16
USCA_DISK_MARGIN_PERCENT=10
USCA_DISK_MARGIN_MIN_BYTES=5000000000
# A --basemap run has no Planetiler, so the ratios do not apply, and its routing stage's disk need
# has never been measured. It keeps the floor every run had before (USCA_MIN_FREE_GB=110, read with
# df -BG, so GiB): 110 x 2^30 bytes.
USCA_BASEMAP_RUN_MIN_FREE_BYTES=118111600640
# The names stage is not in these ratios (Sorrel's review S2). On the NVMe during names-input:
# the highway cut (logged as "names highway cut", deleted at once), then the named cut (2.30 GB for
# 261024), beside the routing input and its bands; after publishing, the .fnm files (0.60 GB for
# 261024) in each kept set. A normal run's need is sized to Planetiler's peak, far above these
# (inferred); a --basemap run's floor is the line above.
# Each output is tens of GB; keep only the one being served from, so a second never crowds out
# the next build. A failed build still leaves it untouched.
USCA_KEEP_GOOD_OUTPUTS=1
# name:lon:lat. Each must have a z15 tile with roads and a .rd5 square over 100 kB, or the build
# is not published: one per region the owner named (RECORD -1274, -1300, and the go of 2026-10-18).
# san-juan is back now that Puerto Rico is a region: it is the point that refused run
# usca-20261019T140722Z, correctly, when no extract held Puerto Rico, and it left on 2026-10-19
# (099a1517). charlotte-amalie is the USVI's, in W65_N15 (pi-03's proposal); it lies inside
# us/us-virgin-islands.poly, read 2026-10-20 (pi-14). That square's size is an estimate, about
# 250 kB from Hawaii's ratio of square to extract, so about 2.5 times the floor, not measured.
USCA_COVERAGE_POINTS="seattle:-122.3350:47.6080 miami:-80.1918:25.7617 anchorage:-149.9003:61.2181 honolulu:-157.8583:21.3069 toronto:-79.3832:43.6532 whitehorse:-135.0568:60.7212 st-johns:-52.7126:47.5615 san-juan:-66.1057:18.4655 charlotte-amalie:-64.9307:18.3419"
# The names files (dispatch pi-31, FNAM v1; build-usca.sh's names_cut and names_encode, and
# bin/build-names.sh). osmium export's node location index for the named-highway input, and the
# encoder's worker processes. flex_mem switched to dense once its first 16.7M nodes had small ids,
# and the ids reaching about 12e9 made dense fatal: osmium was killed at 7.4 GB 40 s into the
# export (build-names.sh on 261024, 2026-10-26). sparse_mem_array is one vector of 16-byte
# entries whose capacity doubles: the 261024 named input's 199,621,707 nodes sit in a 2^28-entry
# vector of 4.29 GB, and osmium peaked at 4.2 GB, with the encoder's own 1.2 GB beside it
# (names-summary.json peak_rss_kib 1,245,744), so about 5.6 GB for the pipeline.
USCA_NAMES_EXPORT_INDEX=sparse_mem_array
USCA_NAMES_JOBS=3
# The operating limit on the named input's nodes, checked right after the cut, before BRouter
# (Sorrel's review S1; the pattern of USCA_BROUTER_MAX_BAND_NODES). One node past 2^28 =
# 268,435,456 doubles the vector to 8.6 GB, more than the Pi has, so the limit sits below that
# with about 3 % in hand. The 5.6 GB above is today's
# figure; at 260M nodes the pipeline would be about 6 GB (inferred), against the Pi's 7.9 GiB. A run stopped by it needs the index changed to the file-backed
# sparse_file_array,<file on the card> (slower; dense_file_array is ruled out by the id range),
# not the limit raised.
USCA_NAMES_MAX_INPUT_NODES=260000000
# BRouter's elevation store (G8, the owner: "G8 from Sunday, app later", from the 2026-11-01 run).
# 182 .bef files at 3", built by G7 on 2026-10-27 from USGS 3DEP 1" (US, clipped to the US
# polygons) and NRCan MRDEM-30 (Canada), one per 5-degree block that has land data
# (Forager-cartography docs/audits/2026-10-26-elevation-g7.md). On the card, which a normal run
# already needs (card_ready; --local and --basemap runs need it now for the store), not on /mnt/storage, which is mounted nofail and doesn't remount
# on a replug; /mnt/storage/elevation/bef3 is the backup. build-usca.sh's bef_store_ok checks it
# in full before the downloads (not on --fetch-only) and again before BRouter, and the run fails
# if it isn't there or isn't this store; after each band, heights_read_ok fails it if a square got
# no heights. PosUnifier gives no height where a block has no .bef: of the 187 squares,
# W170_N20, W180_N25, W80_N25, W95_N15 and W95_N20 have none (no US or Canadian land data).
# Route squares grow 10-14 % with heights (the G6 pilot). A new store means new pins, not an edit.
USCA_BEF_DIR=/mnt/archive/forager-build/elevation/bef3-20261027
USCA_BEF_SUMS_SHA256=36b05da7cee10340f8ccec1249255d97e7b096564323c71f7101fee443102292
USCA_BEF_FILES=182
# The blocks without a .bef, so with no heights, by design (above). Any other square that PosUnifier
# reads no heights for stops the run (heights_read_ok, Sorrel's review S1).
USCA_BEF_NONE="W170_N20 W180_N25 W80_N25 W95_N15 W95_N20"
