+  static final int FORAGER_STREETS_MIN_ZOOM = 10;
+
+
   private final CountryCoder countryCoder;
 
   public Roads(CountryCoder countryCoder) {
@@ -407,6 +411,14 @@ public class Roads implements ForwardingProfile.LayerPostProcessor, ForwardingPr
         foragerMinZoom = Math.min(minZoom, 12);
       }
     }
+    // Forager: residential, unclassified and road streets from FORAGER_STREETS_MIN_ZOOM, before upstream's 12, so the
+    // street grid shows at glance level as OpenStreetMap's map does (dispatch 2026-10-30-coder-05, after the pilot
+    // coder-02; the owner: "Streets only (Recommended)", "Z10 is good", "From Sunday's run (Recommended)"). Service
+    // roads and raceways keep upstream's zoom; the same rules as above apply.
+    if (kind.equals("minor_road") && !sf.hasTag("access", "private", "no") &&
+      (kindDetail.equals("residential") || kindDetail.equals("unclassified") || kindDetail.equals("road"))) {
+      foragerMinZoom = Math.min(minZoom, FORAGER_STREETS_MIN_ZOOM);
+    }
 
     var feat = features.line("roads")
       .setId(FeatureId.create(sf))
