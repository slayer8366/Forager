+package com.protomaps.basemap.layers;
+
+import static com.onthegomap.planetiler.TestUtils.newLineString;
+import static com.onthegomap.planetiler.TestUtils.newPoint;
+
+import com.onthegomap.planetiler.reader.SimpleFeature;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+/** Forager's barriers layer (dispatch 2026-10-28): fences, walls, hedges and retaining walls as lines, zoom 15 only. */
+class BarriersTest extends LayerTest {
+
+  private Iterable<com.onthegomap.planetiler.FeatureCollector.Feature> way(String barrier) {
+    return process(SimpleFeature.create(newLineString(0, 0, 1, 1), new HashMap<>(Map.of("barrier", barrier)), "osm", null, 0));
+  }
+
+  @Test
+  void foragerFenceIsALineAtZoom15() {
+    assertFeatures(15, List.of(Map.of("kind", "fence", "_layer", "barriers", "_type", "line")), way("fence"));
+  }
+
+  @Test
+  void foragerWallHedgeRetainingWall() {
+    assertFeatures(15, List.of(Map.of("kind", "wall")), way("wall"));
+    assertFeatures(15, List.of(Map.of("kind", "hedge")), way("hedge"));
+    assertFeatures(15, List.of(Map.of("kind", "retaining_wall")), way("retaining_wall"));
+  }
+
+  @Test
+  void foragerClosedHedgeIsItsOutline() {
+    assertFeatures(15, List.of(Map.of("kind", "hedge", "_type", "line")),
+      process(SimpleFeature.create(newLineString(0, 0, 1, 0, 1, 1, 0, 1, 0, 0), new HashMap<>(Map.of("barrier", "hedge")), "osm", null, 0)));
+  }
+
+  @Test
+  void foragerOtherBarriersAndPointsAreLeftOut() {
+    assertFeatures(15, List.of(), way("gate"));
+    assertFeatures(15, List.of(), way("kerb"));
+    assertFeatures(15, List.of(),
+      process(SimpleFeature.create(newPoint(0, 0), new HashMap<>(Map.of("barrier", "fence")), "osm", null, 0)));
+  }
+
+  @Test
+  void foragerZoom15Only() {
+    assertFeatures(15, List.of(Map.of("kind", "fence", "_minzoom", 15)), way("fence"));
+  }
+}
