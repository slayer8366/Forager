@@ -0,0 +1,46 @@
+package com.protomaps.basemap.layers;
+
+import com.onthegomap.planetiler.FeatureCollector;
+import com.onthegomap.planetiler.FeatureMerge;
+import com.onthegomap.planetiler.ForwardingProfile;
+import com.onthegomap.planetiler.VectorTile;
+import com.onthegomap.planetiler.geo.GeometryException;
+import com.onthegomap.planetiler.reader.SourceFeature;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Forager's own layer, not upstream's: OpenStreetMap's fences, walls, hedges and retaining walls, as lines at zoom 15
+ * only (dispatch 2026-10-28; the owner's go of 10-28 ~15:10 PDT). The app's way to a waypoint refuses a straight leg
+ * that crosses one: they stand in for property lines, which OpenStreetMap rarely maps. A closed way (a hedge round a
+ * garden) is its outline, so a leg into it crosses it. No style draws this layer.
+ */
+public class Barriers implements ForwardingProfile.LayerPostProcessor {
+
+  public static final String LAYER_NAME = "barriers";
+
+  /** The barrier=* values kept, each its own kind. */
+  static final Set<String> KINDS = Set.of("fence", "wall", "hedge", "retaining_wall");
+
+  @Override
+  public String name() {
+    return LAYER_NAME;
+  }
+
+  public void processOsm(SourceFeature sf, FeatureCollector features) {
+    String kind = sf.getString("barrier");
+    if (kind == null || !KINDS.contains(kind) || !sf.canBeLine()) {
+      return;
+    }
+    features.line(LAYER_NAME)
+      .setAttr("kind", kind)
+      .setMinPixelSize(0)
+      .setPixelTolerance(0)
+      .setMinZoom(15);
+  }
+
+  @Override
+  public List<VectorTile.Feature> postProcess(int zoom, List<VectorTile.Feature> items) throws GeometryException {
+    return FeatureMerge.mergeLineStrings(items, 0, 0, 4);
+  }
+}
