+
+  /** The mark: one point with no fields at the tile's corner, added to every zoom-15 tile after its layers are done. */
+  @Override
+  public Map<String, List<VectorTile.Feature>> postProcessTile(TileCoord tile, Map<String, List<VectorTile.Feature>> layers) {
+    if (tile.z() != 15) {
+      return layers;
+    }
+    List<VectorTile.Feature> barriers = new ArrayList<>(layers.getOrDefault(LAYER_NAME, List.of()));
+    barriers.add(MARK);
+    layers.put(LAYER_NAME, barriers);
+    return layers;
+  }
+
+  /** One point at (0, 0), no id, no fields. */
+  static final VectorTile.Feature MARK =
