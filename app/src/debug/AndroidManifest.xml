<?xml version="1.0" encoding="utf-8"?>
<!--
  The DEBUG build's manifest additions, merged over src/main/AndroidManifest.xml in debug builds
  only. Release builds never see these (dispatch 2026-09-28-532; checked against the merged
  release manifest).

  For the walk logger (diagnostics/WalkLogger.kt), which runs only while the Diagnostics screen's
  "Walk logger" switch is on:
  - ACTIVITY_RECOGNITION: the step detector and step counter (API 29 and up). A runtime permission
    the app never asks for; granted over USB with
    adb shell pm grant com.zynergylabs.forager.app android.permission.ACTIVITY_RECOGNITION
    Without it the log says the step sensors are unsupported for that reason.
  - READ_BASIC_PHONE_STATE: the data network type (LTE, 5G) in the log's header, so each file says
    whether its phone had mobile data (Amendment 1). Granted the same way; without it the header
    says so.
  - ACCESS_NETWORK_STATE: whether the phone was on Wi-Fi or mobile data at the start. A normal
    permission, granted at install.
  - WAKE_LOCK: the logger holds a partial wake lock while it logs (RECORD -559, choice 3). A normal
    permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- RAW stage 3, piece 1 (dispatch 2026-10-15-06): the burst-rate and lock probe's trigger, debug builds only.
             Exported because adb's shell is another app; guarded by DUMP, which the shell holds and an installed app
             cannot be granted. Trigger and read, with the camera dialog open:
               adb shell am broadcast -n com.zynergylabs.forager.app/.diagnostics.burst.BurstProbeReceiver -a com.zynergylabs.forager.app.debug.BURST_PROBE
               adb logcat -v raw -s BurstProbe -->
        <receiver
            android:name="com.zynergylabs.forager.app.diagnostics.burst.BurstProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.zynergylabs.forager.app.debug.BURST_PROBE" />
            </intent-filter>
        </receiver>
        <!-- RAW stage 3, the fast-burst test (dispatch 2026-10-15-09): borrows the camera from CameraX for four 8-frame RAW
             bursts through the platform camera interface, saves them as DNGs under files/raw-burst-test/, and hands the
             camera back. Debug builds only; guarded by DUMP like the receiver above. Trigger and read, with the camera
             dialog open:
               adb shell am broadcast -n com.zynergylabs.forager.app/.diagnostics.burst.PlatformBurstReceiver -a com.zynergylabs.forager.app.debug.PLATFORM_BURST
               adb logcat -v raw -s PlatformBurst -->
        <receiver
            android:name="com.zynergylabs.forager.app.diagnostics.burst.PlatformBurstReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.zynergylabs.forager.app.debug.PLATFORM_BURST" />
            </intent-filter>
        </receiver>
        <!-- The sensor watch (dispatch 2026-10-15-12): which physical camera feeds the dialog's camera, by zoom, focus
             distance and light; a zoom stepper on the dialog's camera that always returns to 1.0; and three attempts at
             pinning RAW to the main wide sensor. Debug builds only; guarded by DUMP like the receivers above. Nothing is
             saved but log lines. The four actions and their extras are listed in SensorWatchReceiver's own comment (an
             XML comment cannot hold the double hyphen the extras need). Read:
               adb logcat -v raw -s SensorWatch -->
        <receiver
            android:name="com.zynergylabs.forager.app.diagnostics.sensor.SensorWatchReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.zynergylabs.forager.app.debug.SENSOR_WATCH" />
                <action android:name="com.zynergylabs.forager.app.debug.SENSOR_ZOOM" />
                <action android:name="com.zynergylabs.forager.app.debug.SENSOR_ZOOM_STEPS" />
                <action android:name="com.zynergylabs.forager.app.debug.SENSOR_PIN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
