<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves this app through Android's own backup or device-to-device transfer: the owner's
  standing ruling (the comment above <application> in AndroidManifest.xml, 2026-09-09). Read from
  Android 12 on, where allowBackup="false" alone no longer stops device-to-device transfer (lint
  DataExtractionRules; dispatch 2026-10-17-03, RECORD -1195). Every domain is excluded whole, in
  both sections. BackupAndTransferRulesTest reads this file as compiled.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
