<?xml version="1.0" encoding="utf-8"?>
<!--
  `captures/` is a camera capture's temporary destination — see
  com.zynergylabs.forager.app.photo.CameraCaptureFiles. `photos/`, where FilePhotoStore persists finished log
  photos, never needs a FileProvider URI — this app only ever reads and writes it directly as
  files, it never grants another app access to it.

  `tracks/` is com.zynergylabs.forager.app.export.TrackGpxExporter's directory, under Context.cacheDir rather
  than external-files-path — an exported GPX file only needs to survive
  long enough for the share-sheet target app to read it, not to accumulate for later on-device
  inspection. Exposed here so the Settings "Recorded Tracks" export action can hand a track to
  another app (a map app, email) via Intent.ACTION_SEND.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="captures" path="captures/" />
    <cache-path name="tracks" path="tracks/" />
</paths>
