{
  "version": 8,
  "name": "Forager offline-download smoke test — MapLibre demo vector tiles, no glyphs/labels",
  "sources": {
    "maplibre": {
      "url": "https://demotiles.maplibre.org/tiles/tiles.json",
      "type": "vector"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#D8F2FF"}
    },
    {
      "id": "coastline",
      "type": "line",
      "source": "maplibre",
      "source-layer": "countries",
      "paint": {"line-color": "#198EC8", "line-width": 2}
    },
    {
      "id": "countries-fill",
      "type": "fill",
      "source": "maplibre",
      "source-layer": "countries",
      "paint": {"fill-color": "#EAB38F"}
    },
    {
      "id": "countries-boundary",
      "type": "line",
      "source": "maplibre",
      "source-layer": "countries",
      "paint": {"line-color": "rgba(255, 255, 255, 1)", "line-width": 1}
    },
    {
      "id": "geolines",
      "type": "line",
      "source": "maplibre",
      "source-layer": "geolines",
      "paint": {"line-color": "#1077B0", "line-dasharray": [3, 3]}
    }
  ]
}
