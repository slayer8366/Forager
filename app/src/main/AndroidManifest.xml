<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- For the mushroom log's camera capture (ActivityResultContracts.TakePicture) — see
         com.forager.app.photo.CameraCaptureFiles. Gallery attach needs no permission at all: it
         uses PickVisualMedia, the modern photo picker. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Without this, PlannedTripRow's "Directions" action always reports no maps app installed,
      even with one present: compileSdk/targetSdk 37 means Android's package-visibility rules
      apply, so `PackageManager.resolveActivity()`/`startActivity()` for an implicit `geo:` intent
      report nothing resolvable unless the manifest explicitly declares visibility into it — this
      is Android's own documented pattern for exactly that intent (see the platform docs on
      package visibility and the `geo:` scheme example).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".ForagerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Forager">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Forager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Step 1 of the osmdroid -> MapLibre migration (docs/plans/maplibre-migration.md) — a
             hardware smoke test, not a screen a user ever reaches. No LAUNCHER category, so it
             does not add a second home-screen icon or appear in app switchers/search; exported
             only so `adb shell am start` can reach it reliably regardless of a given device's
             non-exported-activity launch policy — launch it with:
             adb shell am start -n com.forager.app/com.forager.app.ui.map.MapLibreBasemapPreviewActivity
             See com.forager.app.ui.map.MapLibreBasemapPreviewActivity's doc comment. -->
        <activity
            android:name=".ui.map.MapLibreBasemapPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Forager" />

        <!-- Grants the camera app write access to a file under filesDir/captures/ for
             ActivityResultContracts.TakePicture, without exposing broader file access — see
             com.forager.app.photo.CameraCaptureFiles and res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
